      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isRider() {
      return isSignedIn() && request.auth.token.role == 'rider';
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isRider();
    }
    */
  }
}
