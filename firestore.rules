rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMP: open rules for first launch / seeding.
    // Tighten these after Auth is wired (admin-only writes).
    match /{document=**} {
      allow read, write: if true;
    }

    /*
