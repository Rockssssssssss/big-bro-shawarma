# Copy this file to `.env.local` and fill in values from Firebase Console.
# Project settings → Your apps → Web app → SDK setup and configuration

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: enable seed button in admin (set to "true" once)
NEXT_PUBLIC_FIREBASE_ALLOW_SEED=true

# Staff roles — ONE line per variable, comma-separated emails.
# WRONG: repeating NEXT_PUBLIC_ADMIN_EMAILS= on multiple lines (only the last wins).
NEXT_PUBLIC_ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com
NEXT_PUBLIC_RIDER_EMAILS=rider1@gmail.com,rider2@gmail.com,rider3@gmail.com
